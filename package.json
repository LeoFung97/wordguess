{
  "name": "chinese-semantle",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "prepare:vectors": "tsx scripts/prepare-vectors.ts",
    "prepare:tencent": "tsx scripts/prepare-vectors.ts --input=data/raw/light_Tencent_AILab_ChineseEmbedding.bin --words-output=data/words.json --vectors-output=data/vectors.f32 --max-four-char-words=10000",
    "prepare:tencent:full": "tsx scripts/prepare-vectors.ts --input=data/raw/Tencent_AILab_ChineseEmbedding.txt --words-output=data/words.json --vectors-output=data/vectors.f32",
    "prepare:semantic": ".venv-semantic/bin/python scripts/prepare-semantic-knowledge.py --content-only --workers 24 --chunk-size 512",
    "prepare:semantic:sample": ".venv-semantic/bin/python scripts/prepare-semantic-knowledge.py --content-only --limit=5000 --workers 24 --chunk-size 512",
    "prepare:semantic:setup": "python3 -m venv .venv-semantic && .venv-semantic/bin/pip install -r requirements-semantic.txt"
  },
  "dependencies": {
    "@next/eslint-plugin-next": "latest",
    "@tailwindcss/postcss": "^4.3.1",
    "clsx": "latest",
    "next": "latest",
    "opencc-js": "^1.3.1",
    "react": "latest",
    "react-dom": "latest",
    "socket.io": "latest",
    "socket.io-client": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "tailwindcss": "^4.3.1",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
